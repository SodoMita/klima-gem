using GameState

~ start
if show_part == "VOICE":
	Aurora: A-voice
if show_part == "EYES":
	Aurora: B-eyes
if show_part == "EYES" and show_mod == "MAGNET":
	Aurora: C-eyes-magnet
if show_part == "VOICE" and show_mod == "STICKY":
	Aurora: D-voice-sticky
if show_part != "VOICE":
	Aurora: E-not-voice
=> END
